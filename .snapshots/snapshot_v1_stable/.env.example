# Telegram Bot Token (@BotFather dan olingan token)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Admin Telegram ID raqamlari (bir nechta bo'lsa vergul bilan ajrating: 123456789,987654321)
# O'z ID raqamingizni Telegramdagi @userinfobot orqali bilib olishingiz mumkin
ADMIN_IDS=123456789

# Admin bilan bog'lanish foydalanuvchi nomi
SUPPORT_ADMIN_USERNAME=@nothing_related

# Google Sheets sozlamalari
# Google Cloud Console dan olingan Service Account JSON kalit fayl nomi:
CREDENTIALS_FILE=credentials.json

# Google Sheets jadvalingiz nomi (Google Sheetsda yaratilgan jadval nomi):
GOOGLE_SHEET_NAME=Yukla GO - Mijozlar

# Beriladigan ID prefiksi (masalan: YK1, YK2 bo'lsa -> YK)
ID_PREFIX=YK
